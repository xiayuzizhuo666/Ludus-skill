# 微信公众号一条龙配置示例
# 复制为 config/wechat.env 后填写，或直接设置为系统环境变量。
# 不要把真实密钥提交到版本库。

# 公众号后台 → 设置与开发 → 基本配置
WECHAT_APPID=your-appid
WECHAT_APP_SECRET=your-appsecret

# 草稿作者名（可留空）
WECHAT_AUTHOR=你的作者名

# 文章、配图、HTML、状态文件的输出目录
# 相对路径按当前工作目录解析；建议使用绝对路径
WECHAT_ARTICLES_DIR=./articles

# 默认视觉风格：daily | warm | professional | lively
WECHAT_DEFAULT_STYLE=daily

# 可选：落款文字；留空则不加落款
WECHAT_SIGNATURE=
